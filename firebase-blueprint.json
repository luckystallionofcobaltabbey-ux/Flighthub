{
  "entities": {
    "UserWorkspace": {
      "title": "UserWorkspace",
      "description": "Root workspace anchor for a verified developer or beta tester account.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "updatedAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private PII profile isolated inside users/{userId}/private/profile.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "email", "displayName", "updatedAt"]
    },
    "CabinState": {
      "title": "CabinState",
      "description": "Zero-PII shared 180-seat cabin occupancy list across developer and beta testers.",
      "type": "object",
      "properties": {
        "occupiedSeats": {
          "type": "array"
        },
        "lastActorUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["occupiedSeats", "lastActorUid", "updatedAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Confirmed FlightHub Lmtd passenger ticket submitted by the developer or a beta tester.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 254
        },
        "actorRole": {
          "type": "string",
          "enum": ["developer", "tester"],
          "maxLength": 20
        },
        "bookingId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passengerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "citizenship": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "seatPreference": {
          "type": "string",
          "enum": ["Window", "Middle", "Aisle", "No Preference"],
          "maxLength": 20
        },
        "seatBooked": {
          "type": "string",
          "maxLength": 6,
          "pattern": "^([1-9]|[12][0-9]|30)[A-F]$"
        },
        "preferenceStatus": {
          "type": "string",
          "maxLength": 80
        },
        "airline": {
          "type": "string",
          "maxLength": 100
        },
        "airlineCode": {
          "type": "string",
          "maxLength": 8,
          "pattern": "^[A-Z0-9]{2,6}$"
        },
        "departureDateTime": {
          "type": "string",
          "maxLength": 32
        },
        "departureAirport": {
          "type": "string",
          "maxLength": 6,
          "pattern": "^[A-Z]{3}$"
        },
        "departureTzLabel": {
          "type": "string",
          "maxLength": 32
        },
        "arrivalDateTime": {
          "type": "string",
          "maxLength": 32
        },
        "arrivalAirport": {
          "type": "string",
          "maxLength": 6,
          "pattern": "^[A-Z]{3}$"
        },
        "arrivalTzLabel": {
          "type": "string",
          "maxLength": 32
        },
        "durationMinutes": {
          "type": "number"
        },
        "distanceKm": {
          "type": "number"
        },
        "fare": {
          "type": "number"
        },
        "fareBreakdown": {
          "type": "object"
        },
        "payment": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 40
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "actorEmail",
        "actorRole",
        "bookingId",
        "passengerName",
        "citizenship",
        "seatPreference",
        "seatBooked",
        "preferenceStatus",
        "airline",
        "airlineCode",
        "departureDateTime",
        "departureAirport",
        "arrivalDateTime",
        "arrivalAirport",
        "fare",
        "createdAt",
        "serverCreatedAt"
      ]
    },
    "AppEvent": {
      "title": "AppEvent",
      "description": "Telemetry event recorded across developer and beta tester sessions for Backend Developer Portal.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorEmail": {
          "type": "string",
          "maxLength": 254
        },
        "actorRole": {
          "type": "string",
          "enum": ["developer", "tester"],
          "maxLength": 20
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": [
            "SESSION_BOOT",
            "BOOKING_CREATED",
            "PAYMENT_AUTHORIZED",
            "PAYMENT_DECLINED",
            "TICKET_CANCELLED",
            "TICKET_SEARCHED",
            "SAMPLE_DATA_LOADED",
            "CABIN_RESET"
          ],
          "maxLength": 32
        },
        "timestamp": {
          "type": "string",
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "maxLength": 300
        },
        "metadata": {
          "type": "object"
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "actorEmail",
        "actorRole",
        "id",
        "type",
        "timestamp",
        "summary",
        "serverCreatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserWorkspace" },
      "description": "Verified developer or tester workspace anchor."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Split-collection private PII profile."
    },
    "/cabin_state/{docId}": {
      "schema": { "$ref": "#/entities/CabinState" },
      "description": "Shared zero-PII 180-seat occupancy document (docId == 'shared')."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Multi-tester & developer booking pool readable by owner or verified developer admin."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/AppEvent" },
      "description": "Multi-tester & developer event telemetry readable by owner or verified developer admin."
    }
  }
}
